<h2 class=3D"auto-cursor-target" id=3D"id-202112API=EC=84=9C=EB=B2=84OOMKil=
led-yaml">yaml</h2>
<ul>
<li>-Xms512m -Xmx1024m - m=EC=9D=80 Mi, g=EB=8A=94 Gi =EC=9D=98=EB=AF=B8</l=
i>
</ul>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: java; gutter: false; theme: Confluence" data-theme=3D"Confluence">apiVers=
ion : apps/v1          =20
kind : Deployment             =20
metadata :
  name : search-api
spec:
  replicas: 3                 =20
  template:                   =20
    metadata:                 =20
      labels:
        app.kubernetes.io/name: search-api
        app.kubernetes.io/part-of: search-api
    spec:
      containers:
      - name: app
        image: search-api/app
        imagePullPolicy: IfNotPresent  =20
        env:
        - name: JAVA_TOOL_OPTIONS      =20
          value: "-Xms512m -Xmx1024m"   =20
        - name: SPRING_PROFILES_ACTIVE =20
          value: production
        resources:
          limits:
            memory: "1.25Gi"
            cpu: "1"
          requests:
            memory: "500Mi"
            cpu: "500m"
      - name: nginx
        image: search-api/nginx
        imagePullPolicy: IfNotPresent  =20
        resources:
          limits:
            memory: "500Mi"
            cpu: "500m"
          requests:
            memory: "250Mi"
            cpu: "250m"
      dnsPolicy: ClusterFirst
      restartPolicy: Always
      terminationGracePeriodSeconds: 30
status: {}</pre>
</div>
</div>
